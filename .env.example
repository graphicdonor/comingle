# Canonical production URL — used for robots.txt/sitemap.xml/OG image
# absolute URLs. Defaults to the current Netlify URL if unset; override once
# a custom domain is attached (see src/lib/site-url.ts).
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Media storage — images/videos upload to Cloudinary (see ARCHITECTURE.md)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin panel (/admin) — single shared password, no per-admin accounts
ADMIN_SECRET=

# Dev-mode auth bypass (localStorage-backed, no real Supabase writes) — see src/lib/dev-auth.ts
NEXT_PUBLIC_DEV_MODE=false
NEXT_PUBLIC_DEV_PHONE=
NEXT_PUBLIC_DEV_OTP=

# Content moderation — see MODERATION.md
# Without this set, all moderated content fails closed to hold_for_review
# rather than being allowed through.
OPENAI_API_KEY=
MODERATION_BLOCK_THRESHOLD=0.85
MODERATION_REVIEW_THRESHOLD=0.5
AUTO_BAN_VIOLATION_COUNT=3
AUTO_BAN_WINDOW_DAYS=30
